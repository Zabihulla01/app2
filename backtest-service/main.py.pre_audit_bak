@app.get("/paper/sell/{stock}")

def paper_sell(

    stock:str,

    qty:int=1

):

    global PAPER_BALANCE


    for pos in PAPER_POSITIONS:


        if (

            pos["Stock"] == stock

            and

            pos["Qty"] >= qty

        ):


            df = yf.download(

                stock,

                period="1d",

                interval="1m",

                auto_adjust=True

            )


            price = round(

                float(

                    df["Close"]

                    .iloc[-1]

                ),

                2

            )


            value = round(

                price * qty,

                2

            )


            PAPER_BALANCE += value


            pos["Qty"] -= qty

            if pos["Qty"] == 0:

               PAPER_POSITIONS.remove(pos)


            return {

                "Action":

                "SELL",

                "Stock":

                stock,

                "Qty":

                qty,

                "Price":

                price,

                "Balance":

                round(

                    PAPER_BALANCE,

                    2

                )

            }


    return {

        "Error":

        "Position not found"

    }

