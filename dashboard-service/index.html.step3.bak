<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Trading Terminal</title>

<link rel="stylesheet" href="style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

<div class="sidebar">

    <h2>AI TERMINAL</h2>

    <ul>
        <li>Dashboard</li>
        <li>Scanner</li>
        <li>Backtesting</li>
        <li>Risk Analysis</li>
        <li>Performance</li>
    </ul>

</div>

<div class="main">

    <div class="header">

        <h1>AI Trading Dashboard</h1>

        <div class="search-box">

            <input
    type="text"
    id="stockSelect"
    list="stocks"
    placeholder="Search Any Stock (RELIANCE.NS)"
    autocomplete="off"
/>

<datalist id="stocks"></datalist>

<select id="tradingMode">

    <option value="INTRADAY">
        Intraday
    </option>

    <option value="SWING">
        Swing
    </option>

</select>

<button onclick="analyzeStock()">
    Analyze
</button>

        </div>

    </div>

    <!-- METRICS -->

    <div class="top-cards">

        <div class="card">
            <h3>Win Rate</h3>
            <h1 id="winrate">0%</h1>
        </div>

        <div class="card">
            <h3>Profit Factor</h3>
            <h1 id="pf">0</h1>
        </div>

        <div class="card">
            <h3>Sharpe</h3>
            <h1 id="sharpe">0</h1>
        </div>

        <div class="card">
            <h3>Risk Score</h3>
            <h1 id="riskscore">0</h1>
        </div>

        <div class="card">
            <h3>Trades</h3>
            <h1 id="trades">0</h1>
        </div>

        <div class="card">
            <h3>Drawdown</h3>
            <h1 id="drawdown">0%</h1>
        </div>

        <div class="card">
            <h3>Entry</h3>
            <h1 id="entryprice">-</h1>
        </div>

        <div class="card">
            <h3>Stop Loss</h3>
            <h1 id="stoploss">-</h1>
        </div>

        <div class="card">
            <h3>Target</h3>
            <h1 id="target">-</h1>
        </div>

        <div class="card">
            <h3>Confidence</h3>
            <h1 id="confidence">0%</h1>
        </div>

	<div class="card">
           <h3>Accuracy</h3>
           <h1 id="accuracy">0%</h1>
       </div>

	<div class="card">
    <h3>Mode</h3>
    <h1 id="mode">-</h1>
</div>

<div class="card">
    <h3>ATR</h3>
    <h1 id="atr">0</h1>
</div>

<div class="card">
    <h3>Risk ₹</h3>
    <h1 id="risk">0</h1>
</div>

<div class="card">
    <h3>Reward ₹</h3>
    <h1 id="reward">0</h1>
</div>

    </div>

    <!-- SCANNER -->

    <div class="panel">

        <h2>🔥 Top Opportunities</h2>

        <div id="scanner-results">
            Loading...
        </div>

    </div>

    <!-- AI SIGNAL -->

    <div class="panel">

        <h2>🤖 AI Recommendation</h2>

        <h1 id="recommendation">WAIT</h1>

        <h3 id="best-strategy">-</h3>

    </div>

    <!-- CHART -->

    <div class="panel">

        <h2> Equity Curve</h2>

        <canvas id="equityChart"></canvas>

    </div>

    <!-- SUMMARY -->

    <div class="panel">

        <h2>Backtest Summary</h2>

        <table id="summary-table">

            <tbody>

                <tr>
                    <td>Final Capital</td>
                    <td id="finalcapital">$0</td>
                </tr>

                <tr>
                    <td>Net Profit</td>
                    <td id="netprofit">$0</td>
                </tr>

                <tr>
                    <td>Benchmark Return</td>
                    <td id="benchmark">0%</td>
                </tr>

                <tr>
                    <td>Max Loss Streak</td>
                    <td id="lossstreak">0</td>
                </tr>

            </tbody>

        </table>

    </div>

    <!-- STRATEGIES -->

    <div class="panel">

        <h2>⚔️ Strategy Comparison</h2>

        <canvas id="strategyChart"></canvas>

    </div>

    <div class="panel">

        <h2> Strategy Ranking</h2>

        <table id="ranking-table">

            <thead>

                <tr>
                    <th>Strategy</th>
                    <th>Profit Factor</th>
                </tr>

            </thead>

            <tbody></tbody>

        </table>

    </div>

</div>

<script src="app.js"></script>

</body>
</html>
